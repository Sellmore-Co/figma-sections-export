const fs = require('fs');
const path = require('path');

const { parseArgs } = require('../compare-score');
const { resolveSectionCapture, resolveSectionIndex } = require('../lib/compare-shared');
const { evaluateThreshold, resolveThresholds, scorePair } = require('../lib/score');
const { appendEntry, inspectLoop, resetLedger } = require('../lib/loop-ledger');

module.exports = ({ assert, fixtures, test }) => {
  const reference = path.join(fixtures, 'score-reference.png');
  const identical = path.join(fixtures, 'score-identical.png');
  const defect = path.join(fixtures, 'score-defect.png');
  const dimensionMismatch = path.join(fixtures, 'score-dimension-mismatch.png');
  const sectionCaptureRoot = path.join(fixtures, 'section-capture');
  const sectionCaptureSrc = path.join(sectionCaptureRoot, 'src', 'fake');
  const sectionCapturePage = path.join(sectionCaptureSrc, 'landing.html');
  const sectionCaptureIncludes = path.join(sectionCaptureSrc, '_includes');

  console.log('compare score');
  test('identical PNGs score zero', async () => {
    const result = await scorePair(reference, fs.readFileSync(identical));
    assert.strictEqual(result.score, 0);
    assert.strictEqual(result.dimensionsMatch, true);
    assert.deepStrictEqual(result.topRegions, []);
  });

  test('defect scores above zero and localizes the correct grid cell', async () => {
    const result = await scorePair(reference, defect);
    assert.ok(result.score > 0);
    assert.strictEqual(result.topRegions[0].row, 8);
    assert.strictEqual(result.topRegions[0].column, 4);
    assert.deepStrictEqual(result.topRegions[0].bounds, { x: 42, y: 42, width: 11, height: 6 });
    assert.strictEqual(result.topRegions[0].mismatchRatio, 1);
  });

  test('dimension mismatch trips the independent dimension gate', async () => {
    const result = await scorePair(reference, dimensionMismatch);
    assert.strictEqual(result.dimensionsMatch, false);
    assert.deepStrictEqual(result.dimensionDelta, { width: 4, height: 0 });
  });

  test('threshold flag parses and flips aggregate pass/fail', async () => {
    const parsed = parseArgs(['campaign', '--threshold', '0.01']);
    assert.strictEqual(parsed.threshold, 0.01);

    const identicalResult = await scorePair(reference, identical);
    const defectResult = await scorePair(reference, defect);
    assert.strictEqual(evaluateThreshold([identicalResult], parsed.threshold), true);
    // Maximum-mismatch threshold is inclusive: score == threshold passes,
    // so --threshold 0 can pass for identical images.
    assert.strictEqual(evaluateThreshold([identicalResult], 0), true);
    assert.strictEqual(evaluateThreshold([defectResult], defectResult.score), true);
    assert.strictEqual(evaluateThreshold([defectResult], defectResult.score - 1e-9), false);
    assert.strictEqual(evaluateThreshold([identicalResult], null), null);
  });

  test('dimension gate fails independently of the optional threshold', async () => {
    const mismatchResult = await scorePair(reference, dimensionMismatch);
    assert.strictEqual(evaluateThreshold([mismatchResult], null), false);
    assert.strictEqual(evaluateThreshold([mismatchResult], 1), false);
  });

  test('threshold precedence is flag, then calibration, then null', () => {
    const calibration = { desktop: { threshold: 0.01 }, tablet: { threshold: 0.02 }, mobile: { threshold: 0.03 } };
    assert.deepStrictEqual(resolveThresholds(0.5, calibration, ['desktop', 'tablet', 'mobile']), {
      thresholds: { desktop: 0.5, tablet: 0.5, mobile: 0.5 }, source: 'flag',
    });
    assert.strictEqual(resolveThresholds(null, calibration, ['desktop', 'tablet', 'mobile']).source, 'calibration');
    assert.deepStrictEqual(resolveThresholds(null, null, ['desktop']), { thresholds: null, source: null });
  });

  test('per-breakpoint thresholds are evaluated independently', () => {
    const scores = {
      desktop: { score: 0.011, dimensionsMatch: true },
      mobile: { score: 0.011, dimensionsMatch: true },
    };
    assert.strictEqual(evaluateThreshold(scores, { desktop: 0.01, mobile: 0.02 }), false);
    scores.desktop.score = 0.009;
    assert.strictEqual(evaluateThreshold(scores, { desktop: 0.01, mobile: 0.02 }), true);
  });

  test('loop hard-stops at max iterations and recorded max cannot be raised', () => {
    let ledger = null;
    for (let i = 0; i < 3; i += 1) ledger = appendEntry(ledger, { scores: { desktop: 0.3 - i * 0.1 }, pass: false }, { maxIterations: 3, minDelta: 0 });
    const refusal = inspectLoop(ledger, { maxIterations: 99, minDelta: 0 });
    assert.strictEqual(refusal.exitCode, 2);
    assert.match(refusal.stopReason, /max iterations \(3\)/);
  });

  test('loop hard-stops on stagnation and worsening', () => {
    const limits = { maxIterations: 5, minDelta: 0.05 };
    let stagnant = appendEntry(null, { scores: { desktop: 0.2 }, pass: false }, limits);
    stagnant = appendEntry(stagnant, { scores: { desktop: 0.195 }, pass: false }, limits);
    assert.match(inspectLoop(stagnant, limits).stopReason, /score not improving/);
    let worsening = appendEntry(null, { scores: { desktop: 0.2 }, pass: false }, limits);
    worsening = appendEntry(worsening, { scores: { desktop: 0.25 }, pass: false }, limits);
    assert.match(inspectLoop(worsening, limits).stopReason, /score not improving/);
  });

  test('pass starts the next loop fresh and reset is represented by an empty ledger', () => {
    const limits = { maxIterations: 5, minDelta: 0.05 };
    let ledger = appendEntry(null, { scores: { desktop: 0.2 }, pass: false }, limits);
    ledger = appendEntry(ledger, { scores: { desktop: 0.001 }, pass: true }, limits);
    ledger = appendEntry(ledger, { scores: { desktop: 0.3 }, pass: false }, limits);
    assert.strictEqual(ledger.entries.length, 1);
    assert.strictEqual(ledger.entries[0].iteration, 1);
    assert.strictEqual(inspectLoop(null, limits).stopReason, null);
    const tmpDir = fs.mkdtempSync(path.join(require('os').tmpdir(), 'loop-ledger-'));
    const ledgerPath = path.join(tmpDir, 'loop.json');
    fs.writeFileSync(ledgerPath, '{}');
    resetLedger(ledgerPath);
    assert.strictEqual(fs.existsSync(ledgerPath), false);
    fs.rmSync(tmpDir, { recursive: true, force: true });
  });

  test('capture flags parse selector and full-page escape hatches', () => {
    const selected = parseArgs(['campaign', 'hero-1', '--selector', '[data-hero]']);
    assert.strictEqual(selected.selector, '[data-hero]');
    assert.strictEqual(selected.fullPage, false);

    const fullPage = parseArgs(['campaign', 'hero-1', '--full-page']);
    assert.strictEqual(fullPage.selector, null);
    assert.strictEqual(fullPage.fullPage, true);

    assert.match(parseArgs(['campaign', '--selector']).error, /Missing value/);
    assert.match(parseArgs(['campaign', '--selector', '#hero', '--full-page']).error, /cannot be used together/);
  });

  test('section indexes follow include order and ignore zero-section partials', () => {
    const expectedIndexes = {
      alpha: 0,
      gamma: 3,
    };

    for (const [section, expectedIndex] of Object.entries(expectedIndexes)) {
      const resolution = resolveSectionIndex({
        pagePath: sectionCapturePage,
        includesDir: sectionCaptureIncludes,
        section,
      });
      assert.deepStrictEqual(resolution, { index: expectedIndex, reason: null });
    }
  });

  test('zero-section target partial fails resolution instead of capturing a neighbor', () => {
    const resolution = resolveSectionIndex({
      pagePath: sectionCapturePage,
      includesDir: sectionCaptureIncludes,
      section: 'spacer',
    });
    assert.strictEqual(resolution.index, null);
    assert.match(resolution.reason, /has 0 root <section> elements/);
  });

  test('multi-root target partial fails resolution (single element cannot scope it)', () => {
    const resolution = resolveSectionIndex({
      pagePath: sectionCapturePage,
      includesDir: sectionCaptureIncludes,
      section: 'beta',
    });
    assert.strictEqual(resolution.index, null);
    assert.match(resolution.reason, /has 2 root <section> elements/);
  });

  test('target include nested inside a literal section is rejected', () => {
    const nestedPage = path.join(sectionCaptureSrc, 'landing-nested.html');
    const resolution = resolveSectionIndex({
      pagePath: nestedPage,
      includesDir: sectionCaptureIncludes,
      section: 'alpha',
    });
    assert.strictEqual(resolution.index, null);
    assert.match(resolution.reason, /included inside a literal <section>/);
    const gamma = resolveSectionIndex({
      pagePath: nestedPage,
      includesDir: sectionCaptureIncludes,
      section: 'gamma',
    });
    assert.deepStrictEqual(gamma, { index: 1, reason: null });
  });

  test('literal page-level sections before the include shift the index', () => {
    const literalPage = path.join(sectionCaptureSrc, 'landing-literal.html');
    const alpha = resolveSectionIndex({
      pagePath: literalPage,
      includesDir: sectionCaptureIncludes,
      section: 'alpha',
    });
    assert.deepStrictEqual(alpha, { index: 1, reason: null });
    const gamma = resolveSectionIndex({
      pagePath: literalPage,
      includesDir: sectionCaptureIncludes,
      section: 'gamma',
    });
    assert.deepStrictEqual(gamma, { index: 2, reason: null });
  });

  test('section capture uses landing page and falls back when section is absent', () => {
    const gamma = resolveSectionCapture({
      slug: 'fake',
      section: 'gamma',
      projectRoot: sectionCaptureRoot,
    });
    assert.strictEqual(gamma.entryUrl, 'landing.html');
    assert.strictEqual(gamma.pagePath, sectionCapturePage);
    assert.strictEqual(gamma.sectionIndex, 3);
    assert.strictEqual(gamma.warning, null);

    const absent = resolveSectionCapture({
      slug: 'fake',
      section: 'absent',
      projectRoot: sectionCaptureRoot,
    });
    assert.strictEqual(absent.entryUrl, 'presell.html');
    assert.strictEqual(absent.sectionIndex, null);
    assert.match(absent.warning, /target partial not found/);
    assert.match(absent.warning, /Falling back to full-page capture/);
  });
};
